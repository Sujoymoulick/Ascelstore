<section class="section section--flush" aria-label="Newsletter">
  <div class="join" data-reveal>
    <h2>Get first dibs on<br /><em class="serif">every drop.</em></h2>
    <div>
      <form data-signup>
        <label class="sr-only" for="joinEmail">Email address</label>
        <input id="joinEmail" type="email" required placeholder="Your email address" autocomplete="email" />
        <button class="btn btn--light" type="submit">Join</button>
      </form>
      <p data-signup-msg role="status">Early access and members-only prices. Unsubscribe anytime.</p>
    </div>
  </div>
</section>
